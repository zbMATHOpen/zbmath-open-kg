@prefix zb: <https://zbmath.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix cito: <http://purl.org/spar/cito/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix msc: <http://msc2020.org/> .
@prefix vann: <http://purl.org/vocab/vann/> .

#################################################################
# Ontology
#################################################################

<https://zbmath.org/ontology>
    a owl:Ontology ;

    dcterms:title
        "zbMATH Open Knowledge Graph Ontology"@en ;

    dcterms:description
        "A lightweight OWL ontology describing the entities and relationships generated by the zbMATH Open Knowledge Graph generator. The ontology explicitly declares the external vocabulary terms used by the KG for improved ontology visualization and tooling, while preserving the semantics of Schema.org, Dublin Core Terms, SKOS, and CiTO."@en ;

    dcterms:creator
        <https://github.com/zbMATHOpen/> ;

    dcterms:license
        <https://creativecommons.org/licenses/by/4.0/> ;

    owl:versionIRI
        <https://w3id.org/zbmath/ontology/1.2> ;

    owl:versionInfo
        "1.2" ;

    vann:preferredNamespaceUri
        "https://zbmath.org/" ;

    vann:preferredNamespacePrefix
        "zb" ;

    rdfs:seeAlso
        <https://w3id.org/zbmath/ontology> .


#################################################################
# External Schema.org Classes
#
# These are external vocabulary classes used directly by the KG.
# They are declared here primarily to make the ontology self-
# describing and visualization-friendly.
#################################################################

schema:ScholarlyArticle
    a owl:Class ;
    rdfs:label "Scholarly Article"@en ;
    rdfs:comment
        "Schema.org ScholarlyArticle used as the base type for documents generated by the zbMATH KG."@en .

schema:Person
    a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment
        "Schema.org Person used for authors and reviewers in the zbMATH KG."@en .

schema:Organization
    a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:comment
        "Schema.org Organization used for publishers in the zbMATH KG."@en .

schema:Periodical
    a owl:Class ;
    rdfs:label "Periodical"@en ;
    rdfs:comment
        "Schema.org Periodical used for serials and journals in the zbMATH KG."@en .

schema:Review
    a owl:Class ;
    rdfs:label "Review"@en ;
    rdfs:comment
        "Schema.org Review used for expert reviews of scholarly articles in the zbMATH KG."@en .

schema:SoftwareApplication
    a owl:Class ;
    rdfs:label "Software Application"@en ;
    rdfs:comment
        "Schema.org SoftwareApplication used for mathematical software linked to scholarly articles."@en .

schema:PropertyValue
    a owl:Class ;
    rdfs:label "Property Value"@en ;
    rdfs:comment
        "Schema.org PropertyValue used to represent structured identifiers such as zbl_id."@en .


#################################################################
# External SKOS Classes
#################################################################

skos:Concept
    a owl:Class ;
    rdfs:label "SKOS Concept"@en .

skos:ConceptScheme
    a owl:Class ;
    rdfs:label "SKOS Concept Scheme"@en .


#################################################################
# zbMATH Document Types
#################################################################

<https://zbmath.org/doctype/journal-article>
    a rdfs:Class ;
    rdfs:label "Journal Article"@en ;
    rdfs:subClassOf schema:ScholarlyArticle ;
    skos:notation "j" ;
    rdfs:comment
        "zbMATH document type for journal articles."@en .

<https://zbmath.org/doctype/collection-article>
    a rdfs:Class ;
    rdfs:label "Collection Article"@en ;
    rdfs:subClassOf schema:ScholarlyArticle ;
    skos:notation "a" ;
    rdfs:comment
        "zbMATH document type for articles in collections."@en .

<https://zbmath.org/doctype/book-series>
    a rdfs:Class ;
    rdfs:label "Book Series"@en ;
    rdfs:subClassOf schema:ScholarlyArticle ;
    skos:notation "b" ;
    rdfs:comment
        "zbMATH document type represented by the generator for book-series records."@en .

<https://zbmath.org/doctype/preprints>
    a rdfs:Class ;
    rdfs:label "Preprints"@en ;
    rdfs:subClassOf schema:ScholarlyArticle ;
    skos:notation "p" ;
    rdfs:comment
        "zbMATH document type for preprints."@en .


#################################################################
# zbMATH Semantic Concept Classes
#################################################################

<https://zbmath.org/ontology/msc-concept>
    a rdfs:Class ;
    rdfs:label "MSC Concept"@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:comment
        "Mathematics Subject Classification concept used by the zbMATH KG. Each generated MSC resource is typed both as this class and as skos:Concept."@en .

<https://zbmath.org/ontology/keyword-concept>
    a rdfs:Class ;
    rdfs:label "Keyword Concept"@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:comment
        "Controlled mathematical keyword concept used by the zbMATH KG. Each generated keyword resource is typed both as this class and as skos:Concept."@en .


#################################################################
# Concept Schemes
#
# IMPORTANT:
# These URIs match the KG generator exactly.
#################################################################

<https://zbmath.org/msc-scheme>
    a skos:ConceptScheme ;
    dcterms:title
        "Mathematics Subject Classification (MSC)"@en ;
    rdfs:label
        "MSC Classification"@en .

<https://zbmath.org/keyword-scheme>
    a skos:ConceptScheme ;
    dcterms:title
        "zbMATH Keyword Scheme"@en ;
    rdfs:label
        "zbMATH Keywords"@en .


#################################################################
# Schema.org Object Properties
#################################################################

schema:author
    a owl:ObjectProperty ;
    rdfs:label "author"@en ;
    rdfs:domain schema:ScholarlyArticle ;
    rdfs:range schema:Person ;
    rdfs:comment
        "Links a scholarly article to an author."@en .

schema:authorOf
    a owl:ObjectProperty ;
    rdfs:label "author of"@en ;
    rdfs:domain schema:Person ;
    rdfs:range schema:ScholarlyArticle ;
    owl:inverseOf schema:author ;
    rdfs:comment
        "Links an author to a scholarly article."@en .

schema:keywords
    a owl:ObjectProperty ;
    rdfs:label "keywords"@en ;
    rdfs:domain schema:ScholarlyArticle ;
    rdfs:range skos:Concept ;
    rdfs:comment
        "Links a scholarly article to controlled keyword concepts."@en .

schema:review
    a owl:ObjectProperty ;
    rdfs:label "review"@en ;
    rdfs:domain schema:ScholarlyArticle ;
    rdfs:range schema:Review ;
    owl:inverseOf schema:itemReviewed ;
    rdfs:comment
        "Links a scholarly article to its expert review."@en .

schema:itemReviewed
    a owl:ObjectProperty ;
    rdfs:label "item reviewed"@en ;
    rdfs:domain schema:Review ;
    rdfs:range schema:ScholarlyArticle ;
    owl:inverseOf schema:review ;
    rdfs:comment
        "Links a review to the scholarly article being reviewed."@en .

schema:reviewer
    a owl:ObjectProperty ;
    rdfs:label "reviewer"@en ;
    rdfs:domain schema:Review ;
    rdfs:range schema:Person ;
    rdfs:comment
        "Links a review to the person who authored/reviewed it."@en .

schema:software
    a owl:ObjectProperty ;
    rdfs:label "software"@en ;
    rdfs:domain schema:ScholarlyArticle ;
    rdfs:range schema:SoftwareApplication ;
    rdfs:comment
        "Links a scholarly article to related mathematical software."@en .

schema:isPartOf
    a owl:ObjectProperty ;
    rdfs:label "is part of"@en ;
    rdfs:comment
        "Schema.org isPartOf used by the KG from software resources to articles."@en .

schema:sameAs
    a owl:ObjectProperty ;
    rdfs:label "same as"@en ;
    rdfs:comment
        "Links a KG resource to an equivalent external resource, including DOI resources."@en .

schema:identifier
    a owl:Property ;
    rdfs:label "identifier"@en ;
    rdfs:comment
        "Identifier property used by the KG. Values are heterogeneous RDF resources or literals, including schema:PropertyValue resources, DOI URI resources, and literal software identifiers."@en .

schema:url
    a owl:Property ;
    rdfs:label "URL"@en ;
    rdfs:comment
        "External URL property used by the KG. Generated values may be RDF URI resources or literal fallbacks."@en .


#################################################################
# Schema.org Datatype Properties
#################################################################

schema:name
    a owl:DatatypeProperty ;
    rdfs:label "name"@en .

schema:datePublished
    a owl:DatatypeProperty ;
    rdfs:label "date published"@en ;
    rdfs:range xsd:gYear .

schema:pagination
    a owl:DatatypeProperty ;
    rdfs:label "pagination"@en .

schema:propertyID
    a owl:DatatypeProperty ;
    rdfs:label "property ID"@en .

schema:value
    a owl:DatatypeProperty ;
    rdfs:label "value"@en .

schema:reviewBody
    a owl:DatatypeProperty ;
    rdfs:label "review body"@en .

schema:reviewAspect
    a owl:DatatypeProperty ;
    rdfs:label "review aspect"@en .

schema:inLanguage
    a owl:DatatypeProperty ;
    rdfs:label "in language"@en .


#################################################################
# Dublin Core Terms Properties
#################################################################

dcterms:title
    a owl:DatatypeProperty ;
    rdfs:label "title"@en ;
    rdfs:comment
        "Title of a scholarly resource."@en .

dcterms:creator
    a owl:ObjectProperty ;
    rdfs:label "creator"@en ;
    rdfs:comment
        "Creator relationship used for authors and reviewers."@en .

dcterms:type
    a owl:Property ;
    rdfs:label "type"@en ;
    rdfs:comment
        "Document type. The KG normally uses one of the zbMATH document-type resources, but may emit a literal for an unknown document type code."@en .

dcterms:subject
    a owl:ObjectProperty ;
    rdfs:label "subject"@en ;
    rdfs:range skos:Concept ;
    rdfs:comment
        "Links a document to an MSC concept."@en .

dcterms:language
    a owl:DatatypeProperty ;
    rdfs:label "language"@en .

dcterms:issued
    a owl:DatatypeProperty ;
    rdfs:label "issued"@en ;
    rdfs:range xsd:gYear .

dcterms:identifier
    a owl:DatatypeProperty ;
    rdfs:label "identifier"@en .

dcterms:isPartOf
    a owl:ObjectProperty ;
    rdfs:label "is part of"@en ;
    rdfs:range schema:Periodical .

dcterms:publisher
    a owl:ObjectProperty ;
    rdfs:label "publisher"@en ;
    rdfs:range schema:Organization .


#################################################################
# SKOS Properties
#################################################################

skos:notation
    a owl:DatatypeProperty ;
    rdfs:label "notation"@en .

skos:prefLabel
    a owl:DatatypeProperty ;
    rdfs:label "preferred label"@en .

skos:inScheme
    a owl:ObjectProperty ;
    rdfs:label "in scheme"@en ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:ConceptScheme .

skos:broader
    a owl:ObjectProperty ;
    rdfs:label "broader"@en ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept .

skos:narrower
    a owl:ObjectProperty ;
    rdfs:label "narrower"@en ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept .


#################################################################
# CiTO Properties
#################################################################

cito:cites
    a owl:ObjectProperty ;
    rdfs:label "cites"@en ;
    rdfs:domain schema:ScholarlyArticle ;
    rdfs:range schema:ScholarlyArticle ;
    rdfs:comment
        "Citation relationship between scholarly articles in the zbMATH KG."@en .


#################################################################
# RDFS Properties Used by the KG
#################################################################

rdfs:label
    a owl:DatatypeProperty ;
    rdfs:label "label"@en .

rdfs:comment
    a owl:DatatypeProperty ;
    rdfs:label "comment"@en .

rdfs:seeAlso
    a owl:ObjectProperty ;
    rdfs:label "see also"@en .


#################################################################
# KG-Specific Usage Constraints / Documentation
#################################################################

schema:ScholarlyArticle
    rdfs:comment
        "Every document generated by the KG is explicitly typed as schema:ScholarlyArticle."@en .

schema:Person
    rdfs:comment
        "Persons are generated for authors and reviewers. Author resources are linked using dcterms:creator, schema:author and schema:authorOf. Reviewer resources are linked from reviews using schema:reviewer and dcterms:creator."@en .

schema:Review
    rdfs:comment
        "Reviews are generated as resources at https://zbmath.org/review/{document_id}. They are connected to articles through schema:review and schema:itemReviewed."@en .

schema:SoftwareApplication
    rdfs:comment
        "Software resources are generated at https://zbmath.org/software/{swmath_id}, typed as schema:SoftwareApplication, and linked to articles using schema:software and schema:isPartOf."@en .

schema:Periodical
    rdfs:comment
        "Periodical resources are generated from serial titles and linked from articles using dcterms:isPartOf."@en .

schema:Organization
    rdfs:comment
        "Organization resources are generated from publisher names and linked from articles using dcterms:publisher."@en .

schema:PropertyValue
    rdfs:comment
        "PropertyValue resources are generated as blank nodes for zbl_id identifiers and contain schema:propertyID and schema:value."@en .

<https://zbmath.org/ontology/msc-concept>
    rdfs:comment
        "MSC resources use the MSC 2020 namespace, are typed as skos:Concept and zbMATH MSC Concept, and are connected to documents using dcterms:subject."@en .

<https://zbmath.org/ontology/keyword-concept>
    rdfs:comment
        "Keyword resources are generated under the zbMATH keyword namespace, are typed as skos:Concept and zbMATH Keyword Concept, and are connected to documents using schema:keywords."@en .


#################################################################
# Expected KG Graph Pattern
#################################################################

<https://zbmath.org/ontology>
    rdfs:comment
        "The principal generated KG pattern is: ScholarlyArticle --dcterms:creator/schema:author--> Person; ScholarlyArticle --dcterms:type--> zbMATH document type; ScholarlyArticle --dcterms:subject--> MSC Concept; ScholarlyArticle --schema:keywords--> Keyword Concept; ScholarlyArticle --schema:review--> Review; Review --schema:reviewer/dcterms:creator--> Person; ScholarlyArticle --schema:software--> SoftwareApplication; ScholarlyArticle --dcterms:isPartOf--> Periodical; ScholarlyArticle --dcterms:publisher--> Organization; ScholarlyArticle --cito:cites--> ScholarlyArticle."@en .


#################################################################
# Namespace / Ontology Documentation
#################################################################

<https://zbmath.org/ontology>
    rdfs:seeAlso
        <https://w3id.org/zbmath/ontology> .

<https://w3id.org/zbmath/ontology/1.2>
    rdfs:seeAlso
        <https://zbmath.org/ontology> .
